<?xml version="1.0" encoding="utf-8"?>
<!-- Schedules and settings move to a new phone. Which BedJet this phone talks to does not:
     a new phone pairs with whichever BedJet is nearest, as on first launch. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="BedJetKit.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="BedJetKit.xml" />
    </device-transfer>
</data-extraction-rules>
